func _chars_match_at(haystack, needle, at) {
    var nLen = needle.len();
    if at + nLen > haystack.len() {
        return false;
    }
    var j = 0;
    while j < nLen {
        if haystack[at + j] != needle[j] {
            return false;
        }
        j = j + 1;
    }
    return true;
}

func str_index_of(s, needle) {
    var sChars = s.chars();
    var nChars = needle.chars();
    var nLen = nChars.len();
    if nLen == 0 {
        return 0;
    }
    var i = 0;
    while i <= sChars.len() - nLen {
        if _chars_match_at(sChars, nChars, i) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

func str_contains(s, needle) {
    return str_index_of(s, needle) >= 0;
}

func str_starts_with(s, prefix) {
    return _chars_match_at(s.chars(), prefix.chars(), 0);
}

func str_ends_with(s, suffix) {
    var sChars = s.chars();
    var suChars = suffix.chars();
    if suChars.len() > sChars.len() {
        return false;
    }
    return _chars_match_at(sChars, suChars, sChars.len() - suChars.len());
}

func str_slice(s, start, end) {
    var chars = s.chars();
    var result = "";
    var i = start;
    while i < end {
        result = result + chars[i];
        i = i + 1;
    }
    return result;
}

func str_repeat(s, count) {
    var result = "";
    var i = 0;
    while i < count {
        result = result + s;
        i = i + 1;
    }
    return result;
}

func str_split(s, sep) {
    var sChars = s.chars();
    var sepChars = sep.chars();
    var sepLen = sepChars.len();
    var sLen = sChars.len();
    if sepLen == 0 {
        return sChars;
    }
    var result = [];
    var current = "";
    var i = 0;
    while i < sLen {
        if _chars_match_at(sChars, sepChars, i) {
            result.push(current);
            current = "";
            i = i + sepLen;
        } else {
            current = current + sChars[i];
            i = i + 1;
        }
    }
    result.push(current);
    return result;
}

func str_replace(s, search, replacement) {
    var sChars = s.chars();
    var seChars = search.chars();
    var seLen = seChars.len();
    var sLen = sChars.len();
    if seLen == 0 {
        return s;
    }
    var result = "";
    var i = 0;
    while i < sLen {
        if _chars_match_at(sChars, seChars, i) {
            result = result + replacement;
            i = i + seLen;
        } else {
            result = result + sChars[i];
            i = i + 1;
        }
    }
    return result;
}
